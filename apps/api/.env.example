# Database (PostgreSQL URL - works with Docker, local Postgres, Neon, Supabase, or Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_management?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for web apps and local dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
