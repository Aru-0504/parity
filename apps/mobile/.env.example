# Backend API URL for React Native / Expo
# For Android Emulator against local backend: http://10.0.2.2:5000/api
# For iOS Simulator against local backend: http://localhost:5000/api
# For physical device (LAN): http://<YOUR_LOCAL_IP>:5000/api
# For production deployed backend:
EXPO_PUBLIC_API_URL=https://your-deployed-api.onrender.com/api
