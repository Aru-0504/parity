{
  "name": "ismo-assessment-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full Stack Project Management System (API, Web, Mobile) Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:mobile:tunnel": "npm run start:tunnel --workspace=apps/mobile",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "prisma:deploy": "npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "prisma:seed": "npm run prisma:seed --workspace=api",
    "build:api": "npm run build --workspace=@ismo/shared && npx prisma generate --schema=apps/api/prisma/schema.prisma && npm run build --workspace=api",
    "build:web": "npm run build --workspace=@ismo/shared && npm run build --workspace=web",
    "start:api": "node apps/api/dist/index.js"
  },
  "dependencies": {
    "typescript": "^5.5.4"
  }
}
